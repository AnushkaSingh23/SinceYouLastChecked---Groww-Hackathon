// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Lightweight identity, no password — a handle is enough to persist a
// watchlist across sessions/devices (see PRD.md non-goals: no OAuth in v1).
model User {
  id        String   @id @default(cuid())
  handle    String   @unique
  createdAt DateTime @default(now())

  watchlistItems WatchlistItem[]
}

model WatchlistItem {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol  String

  // Company name captured when the stock was added. Any NSE symbol can now be
  // watched, not just a curated 40, so there is no local table to look a name
  // up in — storing it here avoids a network round trip per item on render.
  name    String?

  addedAt DateTime @default(now())

  lastSeen LastSeenSnapshot?

  @@unique([userId, symbol])
}

// What the user saw the last time they looked at this symbol — the state
// every "what changed since you last checked" computation diffs against.
model LastSeenSnapshot {
  id              String        @id @default(cuid())
  watchlistItemId String        @unique
  watchlistItem   WatchlistItem @relation(fields: [watchlistItemId], references: [id], onDelete: Cascade)

  price     Float
  timestamp DateTime

  // What the user had already *acknowledged*, not just the price. Without
  // these, "mark all as seen" only resets the price baseline: a stock
  // sitting at its 52-week high or in a volume surge stays flagged forever
  // no matter how many times it's acknowledged, and the "N need your
  // attention" headline never returns to zero. scoring.ts diffs against
  // these so every signal is genuinely "since you last checked."
  levelBreak  Boolean @default(false)
  volumeRatio Float?

  // The benchmark index level at the moment this was acknowledged, so the
  // market-relative comparison covers exactly the same window as the stock's
  // own move. Without it the only option is comparing "since you last checked"
  // against the index's move "since yesterday's close" — two different windows,
  // which makes the residual meaningless.
  benchmarkSymbol String?
  benchmarkPrice  Float?
}
