# Local SQLite file. Created by `npx prisma migrate dev`.
DATABASE_URL="file:./dev.db"

# Enables the "⚡ simulate event" demo control in a production build.
# It is on automatically in development. Leave this unset unless you are
# deploying a live demo: the endpoint overlays a fabricated price move and
# headline onto the shared feed every viewer sees.
# ENABLE_DEMO_SHOCKS=true
